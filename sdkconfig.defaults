# 1 ms RTOS tick so delay()/vTaskDelay() has the same resolution as Arduino
CONFIG_FREERTOS_HZ=1000
# robot loop runs pinned on core 1 and busy-waits like Arduino's loop();
# only watch core 0's idle task (same as the Arduino-ESP32 core does)
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# BLE only (NimBLE host), no classic Bluetooth
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
